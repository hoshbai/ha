<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SelectedPhotoAccess"
    package="com.example.campus_life_assistant">

    <!-- 基础网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- 定位权限 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" /> <!-- 后台定位 -->

    <!-- Android 13+ 新增权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" /> <!-- 用户选择的照片 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" /> <!-- 通知权限 -->

    <!-- 可选权限（根据需求保留） -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" /> <!-- 设备状态 -->
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" /> <!-- A-GPS 模块 -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.Campus_Life_Assistant"
        tools:targetApi="31">
        <service android:name="com.amap.api.location.APSService"/>
        <activity
            android:name=".SchoolMapActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".Maptest"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="34fad77680d92978fde97015be1605c3">

        </meta-data>

        <activity
            android:name=".AIChatActivity"
            android:exported="true" />
        <activity
            android:name=".SuSheAnnouncementDetailActivity"
            android:exported="false" />
        <activity
            android:name=".SuSheAnnouncementActivity"
            android:exported="false" />
        <activity
            android:name=".SuSheMemberInfo"
            android:exported="false" />
        <activity
            android:name=".SuSheRepairProcessActivity"
            android:exported="false" />
        <activity
            android:name=".SuSheElectricityChargeActivity"
            android:exported="false" />
        <activity
            android:name=".ScheduleActivity"
            android:exported="true" />
        <activity
            android:name=".RepairActivity"
            android:exported="true" />
        <activity
            android:name=".CanteenActivity"
            android:exported="true" />
        <activity
            android:name=".LoginActivity"
            android:exported="true" /> <!-- 移除intent-filter -->
        <!-- 修改后的StuCardActivity配置 -->
        <activity
            android:name=".StuCardActivity"
            android:exported="true" /> <!-- 必须设置为true -->
        <!-- <activity -->
        <!-- android:name=".HomeActivity" -->
        <activity android:name=".FoodDetailActivity" /> <!-- android:exported="true" /> -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SuSheMainActivity"
            android:exported="false" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
    </application>

</manifest>