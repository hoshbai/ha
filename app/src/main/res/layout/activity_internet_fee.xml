<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".campuscard.activity.InternetFeeActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="支付网费"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"/>

    <TextView
        android:id="@+id/tv_internet_fee_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="当前网费余额: --"
        android:textAppearance="?attr/textAppearanceBodyMedium"/>

    <TextView
        android:id="@+id/tv_current_balance_internet_fee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="当前校园卡余额: --"
        android:textAppearance="?attr/textAppearanceBodyMedium"/>

    <EditText
        android:id="@+id/et_internet_fee_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="请输入支付金额"
        android:inputType="numberDecimal"/>

    <Button
        android:id="@+id/btn_pay_internet_fee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="确认支付"/>

</LinearLayout> 