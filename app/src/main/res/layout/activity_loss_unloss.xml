<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".campuscard.activity.LossUnlossActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="校园卡挂失/解挂"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"/>

    <TextView
        android:id="@+id/tv_card_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="当前卡片状态: --"
        android:textAppearance="?attr/textAppearanceBodyMedium"/>

    <Button
        android:id="@+id/btn_report_loss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="挂失校园卡"/>

    <Button
        android:id="@+id/btn_unreport_loss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="解挂校园卡"/>

    <!-- TODO: Add more挂失/解挂 related UI elements if needed -->

</LinearLayout> 